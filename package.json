{
  "name": "pi-loop",
  "version": "0.1.6",
  "description": "A pi extension that closes the verification loop on task completion",
  "author": "monotykamary",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotykamary/pi-loop.git"
  },
  "homepage": "https://github.com/monotykamary/pi-loop#readme",
  "bugs": {
    "url": "https://github.com/monotykamary/pi-loop/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "loop",
    "verification",
    "close-loop",
    "agent",
    "productivity"
  ],
  "files": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "tsconfig.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "media/"
  ],
  "dependencies": {},
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.74.0",
    "@earendil-works/pi-coding-agent": ">=0.74.0",
    "@sinclair/typebox": "0.34.49"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@types/node": "25.9.1",
    "@vitest/coverage-v8": "4.1.7",
    "knip": "6.14.1",
    "lint-staged": "17.0.5",
    "prettier": "3.8.3",
    "simple-git-hooks": "2.13.1",
    "standard-version": "9.5.0",
    "typescript": "6.0.3",
    "vitest": "4.1.7",
    "@earendil-works/pi-tui": "0.79.4"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:dead": "knip --no-gitignore",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "standard-version",
    "release:dry-run": "standard-version --dry-run",
    "postinstall": "simple-git-hooks 2>/dev/null || true"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "pre-push": "npm run typecheck && npm run test",
    "commit-msg": "npx commitlint --edit ${1}"
  },
  "lint-staged": {
    "*.{ts,js,json,md}": [
      "prettier --write"
    ]
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills/pi-loop"
    ]
  },
  "overrides": {
    "brace-expansion": "5.0.6",
    "fast-xml-builder": "1.2.0",
    "protobufjs": "8.4.0",
    "ws": "8.20.1"
  },
  "packageManager": "pnpm@11.6.0"
}
